    "comlink": "^4.4.1",
    "exifr": "^7.1.3",
    "fflate": "^0.8.2",
    "heic2any": "^0.0.4",
    "pdf-lib": "^1.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-image-crop": "^11.1.2",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
